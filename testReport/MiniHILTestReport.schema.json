{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "miniHIL Test Report Model",
  "type": "object",
  "properties": {
    "metaInfo": {
      "$ref": "#/definitions/metaInfo"
    },
    "features": {
      "items" : {
        "$ref": "#/definitions/feature",
        "uniqueItems": true
      },
      "type": "array"
    },
    "testSuites": {
      "items" : {
        "$ref": "#/definitions/testSuite",
        "uniqueItems": true
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "required": [
    "features", "testSuites"
  ],
  "definitions": {
    "feature": {
      "type": "object",
      "properties": {
        "mappedTestCases": {
          "items": {
            "type": "integer",
            "uniqueItems": true
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "mappedTestCases"
      ]
    },
    "testSuite": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "metaInfo": {
          "$ref": "#/definitions/metaInfo"
        },
        "testCases": {
          "items": {
            "$ref": "#/definitions/testCase",
            "uniqueItems": true,
            "minimum": 1
          },
          "type": "array"
        },
        "testTraceDiagram": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name", "testCases"
      ]
    },
    "testCase": {
      "type": "object",
      "properties": {
        "metaInfo": {
          "$ref": "#/definitions/metaInfo"
        },
        "comment": {
          "type": "string"
        },
        "frameworkMessage": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [ "message" ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "testSuite": {
          "type": "string"
        },
        "result": {
          "enum": [
            "notExecuted",
            "passed",
            "skipped",
            "failed"
          ],
          "type": "string"
        },
        "executionTime": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name", "id", "testSuite", "result"
      ]
    },
    "metaInfo": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}